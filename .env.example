DEMO_MODE=true
LOG_PATH=/data/app.log
DB_PATH=/data/logpulse.db
ALERTS_JSONL=/data/alerts.jsonl
NTFY_TOPIC=logpulse-CHANGE-ME-long-random
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- AWS (leave AWS_ENABLED=false on machines without credentials) ---
# The real .env (gitignored) exists only on the demo laptop / the person working on the sinks. Never commit keys.
# Use a dedicated least-privilege IAM user (see iam-policy.json); never keys for the root user.
AWS_ENABLED=false
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:<ACCOUNT_ID>:logpulse-alerts
CW_LOG_GROUP=/logpulse/alerts
CW_LOG_STREAM_PREFIX=alerts

# optional extras
# NTFY_BASE_URL=https://ntfy.sh        # point at a self-hosted ntfy
# WEBHOOK_URL=                         # Discord/Slack incoming webhook (then add `webhook` to alerts.sinks)
# LOGPULSE_PROFILE=demo                # demo | prod
