*.pyc
.env
data/*
!data/.gitkeep
# datasets: keep the folder (via .gitkeep) but never commit what is dropped into it
!data/datasets/
data/datasets/*
!data/datasets/.gitkeep
# the ~20 MB compressed dataset IS committed (GitHub rejects files > 100 MB, so the 205 MB raw file never is)
!data/datasets/NASA_access_log_Jul95.gz
.venv/
.pytest_cache/

# tooling output
.coverage
htmlcov/
.ruff_cache/
